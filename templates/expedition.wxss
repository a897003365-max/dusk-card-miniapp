0 1px 2px #fff; }.unit-health text { color: #385b7c; }.versus-line { height: 6px; text-align: center; color: #ecdfba; font-size: 11px; line-height: 6px; }.down { opacity: .45; filter: grayscale(1); }.scene-front { z-index: 1; }.impact { position: absolute; top: 26px; left: 0; right: 0; font-weight: 800; font-size: 24px; color: #a84d34; text-shadow: 0 1px 2px #fff; animation: damageFloat 320ms ease-out both; pointer-events: none; }.impact-heal { color: #577f62; }.impact-shield { color: #396580; }.acting .unit-art { animation: castPulse 320ms ease-in-out; }

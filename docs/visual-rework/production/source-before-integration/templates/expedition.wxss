.expedition { height: 100vh; box-sizing: border-box; display: flex; flex-direction: column; overflow: hidden; background: #f5f0e5; color: #2c3e54; padding-bottom: env(safe-area-inset-bottom); }
.exp-top { height: 48px; flex-shrink: 0; display: flex; align-items: center; border-bottom: 1px solid #d9d2c2; padding: 0 12px; gap: 10px; background: #faf6ee; }.hub-back, .exp-log { margin: 0; flex: 0 0 60px; width: 60px; min-width: 60px; max-width: 60px; min-height: 44px; padding: 8px 0; font-size: 13px; border-radius: 0; color: #52687d; background: transparent; }.exp-log { flex-basis: 44px; margin-left: auto; width: 44px; min-width: 44px; max-width: 44px; }.exp-heading { flex: 1; min-width: 0; font-size: 15px; font-weight: 600; }.exp-heading text { display: block; font-size: 10px; color: #8a806e; font-weight: 400; }
.battle-toolbar { display: flex; align-items: center; justify-content: space-between; height: 44px; padding: 0 14px; flex-shrink: 0; background: #293f56; color: #e6e5d9; font-size: 12px; }.turn-label { margin-right: 13px; }.energy-label { color: #f3cd86; font-weight: 600; }.deck-link { padding: 6px 0; width: auto; min-width: 0; max-width: 155px; background: transparent; font-size: 11px; color: #d3dfe5; }
.battle-stage { position: relative; height: auto; min-height: 330px; flex: 1; display: flex; flex-direction: column; justify-content: space-around; padding: 7px 12px; background: linear-gradient(160deg,#637a83,#b2b6a4 60%,#8e9b8e); overflow: hidden; }.scene-image { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }.stage-light { position: absolute; inset: 0; background: linear-gradient(#172c3d22,#182d3c00 55%,#f3ead850); pointer-events: none; }.enemy-row, .party-row { display: flex; align-items: flex-end; justify-content: space-evenly; gap: 12px; position: relative; z-index: 2; }.enemy-row { min-height: 172px; flex-shrink: 0; }.party-row { height: 138px; }.unit { width: 29%; min-width: 0; min-height: 78px; position: relative; text-align: center; border: 1px solid transparent; border-radius: 10px; padding: 2px 4px; color: #263c50; }.unit.targeted { border-color: #f4c879; background: #fff2cf6e; box-shadow: 0 0 0 2px #6e543343; }.unit-art { width: 88px; height: 90px; display: block; margin: 0 auto; max-width: 100%; filter: drop-shadow(0 3px 3px #12233555); }.enemy-symbol { width: 50px; height: 50px; line-height: 46px; margin: auto; border-radius: 50%; color: #f5e2ba; background: #46566c; border: 3px double #c3b58c; font-size: 28px; }.intent-bubble { font-size: 12px; line-height: 1.25; min-height: 36px; padding: 3px 4px; background: #fdf7e9eb; color: #754f3f; border-radius: 5px; margin: 0 -3px 3px; }.intent-target { white-space: nowrap; }.intent-effect { white-space: nowrap; font-weight: 600; }.intent-note { white-space: normal; word-break: break-all; }.unit-name { font-size: 12px; line-height: 1.35; color: #243b4d; background: #fff6e6de; border-radius: 4px; padding: 1px 2px; white-space: nowrap; }.unit-name text { font-size: 9px; }.health-track { height: 4px; background: #25374744; margin: 3px 0 1px; border-radius: 3px; overflow: hidden; }.health-track view { height: 100%; background: #bc735b; transition: width 230ms ease; }.ally-unit .health-track view { background: #63856d; }.unit-health { background: #f7f2e5dc; border-radius: 3px; font-size: 12px; font-weight: 600; color: #243b4c; line-height: 1.2; text-shadow: 0 1px 2px #fff; }.unit-health text { color: #385b7c; }.versus-line { height: 6px; text-align: center; color: #ecdfba; font-size: 11px; line-height: 6px; }.down { opacity: .45; filter: grayscale(1); }.scene-front { z-index: 1; }.impact { position: absolute; top: 26px; left: 0; right: 0; font-weight: 800; font-size: 24px; color: #a84d34; text-shadow: 0 1px 2px #fff; animation: damageFloat 320ms ease-out both; pointer-events: none; }.impact-heal { color: #577f62; }.impact-shield { color: #396580; }.acting .unit-art { animation: castPulse 320ms ease-in-out; }
.card-preview { height: 90px; min-height: 90px; flex: 0 0 90px; max-height: 90px; padding: 6px 16px 4px; background: #fcf8ef; border-top: 1px solid #d9d1c1; border-bottom: 1px solid #ded7c8; }.preview-title { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 44px; font-size: 17px; }.card-detail-link { width: 44px; min-width: 44px; max-width: 44px; padding: 0; min-height: 44px; color: #836b48; background: transparent; font-size: 11px; }.preview-scroll { height: 47px; font-size: 12px; line-height: 1.65; color: #866d4c; }.preview-main { flex: 1; min-width: 0; }.preview-main > .serif { display: block; font-size: 16px; line-height: 1.35; }.hand-hint { padding-top: 13px; }.hand-hint .serif { font-size: 16px; }.hand-hint text { display: block; font-size: 11px; color: #879096; margin-top: 7px; }
.hand-scroll { height: 106px; flex-shrink: 0; width: 100%; background: #e8dfce; white-space: nowrap; }.hand-track { display: inline-flex; gap: 6px; padding: 9px 16px 8px; height: 106px; box-sizing: border-box; }.hand-card { height: 88px; min-height: 88px; flex-shrink: 0; border-radius: 6px; padding: 4px 3px; background: #fffcf2; border: 1px solid #baa983; color: #3f5662; text-align: center; position: relative; font-weight: 500; box-shadow: 0 3px 0 #cabda3; }.card-cost { position: absolute; left: 3px; top: 2px; font-weight: 700; width: 17px; height: 17px; border-radius: 50%; color: #fff3d8; background: #3f5369; font-size: 11px; line-height: 17px; }.card-role-icon { font-size: 12px; line-height: 22px; margin: 5px auto 4px; color: #ad8b56; }.hand-card-name { white-space: normal; font-size: 11px; line-height: 1.25; height: 28px; overflow: hidden; font-weight: 600; }.hand-owner { display: block; font-size: 11px; line-height: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #819096; margin-top: 3px; }.selected-card { transform: translateY(-4px); border: 2px solid #ba9146; box-shadow: 0 4px 0 #b99a60; }.unplayable { opacity: .65; }.role-guard { border-color: #8ca59a; }.role-combo { border-color: #bf987b; }.role-echo { border-color: #a098b4; }
.battle-actions { height: 59px; flex-shrink: 0; display: flex; align-items: center; gap: 9px; padding: 6px 14px; background: #faf6eb; }.end-turn { flex: 0 0 34%; width: 34%; min-width: 0; max-width: 34%; background: #e4ddcf; color: #526577; font-size: 13px; padding: 6px 3px; border-radius: 9px; }.end-turn text { display: block; font-size: 9px; margin-top: 1px; font-weight: 400; }.confirm-play { flex: 1; width: 0; min-width: 0; color: #f7dfb2; font-size: 14px; border-radius: 9px; padding: 11px 5px; }.compact .battle-stage { min-height: 212px; height: auto; }.compact .enemy-row { min-height: 110px; }.compact .party-row { height: 78px; }.compact .unit-art { width: 56px; height: 36px; }.compact .intent-bubble { min-height: 34px; padding: 2px; }.compact .enemy-symbol { height: 36px; width: 36px; line-height: 30px; font-size: 23px; }.compact .card-preview { height: 52px; min-height: 52px; max-height: 52px; flex-basis: 52px; padding-top: 2px; }.compact .preview-title { font-size: 15px; min-height: 44px; }.compact .preview-main > .serif { font-size: 14px; }.compact .preview-scroll { height: 29px; }.compact .hand-scroll, .compact .hand-track { height: 88px; }.compact .hand-card { height: 77px; min-height: 77px; }.compact .hand-card-name { font-size: 10px; height: 25px; }.compact .card-role-icon { font-size: 11px; line-height: 17px; margin-bottom: 2px; }.compact .hand-owner { font-size: 11px; }
.exp-scroll { flex: 1; min-height: 0; height: 60vh; box-sizing: border-box; padding: 18px; }.journey-banner .serif { font-size: 28px; margin: 11px 0; }.journey-banner text { display: block; font-size: 13px; color: #7a8389; line-height: 1.8; }.journey-banner .eyebrow { font-size: 10px; letter-spacing: 2px; }.travel-party { display: flex; gap: 9px; padding: 18px 0; border-bottom: 1px dashed #cfc5b2; }.travel-party view { flex: 1; min-width: 0; text-align: center; }.travel-party image { width: 48px; height: 48px; display: block; margin: auto; }.travel-party text { font-size: 10px; color: #75818b; }.route-list { margin: 22px 0; }.route-stop { display: flex; gap: 12px; padding-bottom: 24px; opacity: .65; }.route-index { width: 29px; height: 29px; line-height: 27px; border: 1px solid #c1b59c; color: #928166; border-radius: 50%; text-align: center; font-size: 14px; flex-shrink: 0; margin-top: 6px; }.route-content { flex: 1; min-width: 0; }.route-type { font-size: 14px; margin-bottom: 8px; }.route-options { display: flex; gap: 9px; }.route-option { flex: 1; width: 0; min-width: 0; background: #fffbf1; color: #435d72; border: 1px solid #d6cdbd; border-radius: 11px; padding: 13px 9px; font-size: 13px; text-align: left; }.route-option text { display: block; font-size: 10px; font-weight: 400; line-height: 1.6; margin-top: 6px; }.current-stop { opacity: 1; }.current-stop .route-index { color: #fff0cf; background: #9d7c45; border-color: #9d7c45; }.current-stop .route-option { border-color: #aa8a51; }.visited-stop .route-index { background: #dce3d6; border-color: #a6b2a2; }.abandon-link { width: 100%; min-width: 100%; font-size: 12px; color: #97705e; }
.reward-stack { padding-top: 18px; }.reward-card, .relic-choice, .upgrade-choice { padding: 20px; border: 1px solid #c8baa0; border-radius: 15px; background: #fffcf3; margin: 16px 0; }.reward-card-head { display: flex; align-items: center; justify-content: space-between; color: #a48755; font-size: 13px; }.reward-name { font-size: 24px; margin: 12px 0; }.reward-copy { display: block; font-size: 14px; line-height: 1.9; color: #677b89; }.take-card, .take-relic, .upgrade-card { margin-top: 18px; width: 100%; min-width: 100%; font-size: 14px; }.skip-card { width: 100%; min-width: 100%; margin-bottom: 18px; font-size: 13px; }.relic-symbol { font-size: 30px; color: #b08c4f; }.event-letter { background: #ede5d6; border: 1px solid #d7c9af; padding: 24px; margin: 22px 0; border-radius: 14px; }.event-choice { width: 100%; min-width: 100%; text-align: left; padding: 17px; background: #fffbf2; border: 1px solid #d9cbb5; color: #354d64; margin: 14px 0; font-size: 16px; }.event-choice text { display: block; margin-top: 10px; color: #7d8b91; font-size: 13px; line-height: 1.7; font-weight: 400; }.camp-lamp { width: 100px; height: 100px; line-height: 95px; border-radius: 50%; border: 2px double #b29565; background: #e9dcbf; font-size: 65px; text-align: center; color: #8f754a; margin: 28px auto; }.camp-rest, .camp-upgrade { width: 100%; min-width: 100%; margin: 16px 0; font-size: 14px; }.owned-relics { border-top: 1px solid #d8cfbd; padding: 22px 0; }.owned-relics .serif { font-size: 21px; }.owned-relics view + view { margin-top: 14px; }.owned-relics text { display: block; font-size: 12px; line-height: 1.8; }.owned-relics text + text { color: #8b938d; font-size: 11px; }
.exp-result { padding: 28px 5px; text-align: center; }.result-postmark { width: 93px; height: 93px; line-height: 87px; border: 4px double #b89463; border-radius: 50%; color: #937043; margin: 5px auto 25px; transform: rotate(-12deg); font-size: 24px; }.exp-result > .serif { font-size: 30px; line-height: 1.5; }.exp-result > text { font-size: 14px; color: #889095; display: block; margin-top: 16px; }.result-numbers { display: flex; margin: 30px 0; background: #eae3d3; border-radius: 16px; padding: 22px 6px; }.result-numbers view { flex: 1; font-size: 11px; color: #8f7d60; }.result-numbers text { display: block; font-size: 28px; color: #4a5e6d; margin-bottom: 5px; }.result-note { font-size: 13px; line-height: 1.9; color: #8c938c; }.finish-run { width: 100%; min-width: 100%; margin-top: 28px; color: #efd7a8; }
.exp-overlay { z-index: 100; }.exp-dialog { max-height: calc(100vh - 50px); }.deck-item { padding: 17px 0; border-bottom: 1px solid #e3dac8; font-size: 15px; }.deck-item > text { display: block; font-size: 13px; line-height: 1.85; margin-top: 9px; color: #7c8790; }.log-item { padding: 12px 0; border-bottom: 1px solid #e3dac8; font-size: 13px; line-height: 1.8; }.inspected-enemy, .inspected-card { padding: 20px 0; }.inspected-enemy image { height: 140px; width: 100%; }.inspected-enemy > view { margin-bottom: 20px; font-size: 14px; }.inspected-enemy .serif { margin-top: 22px; font-size: 21px; }.inspected-card .tag { margin-bottom: 22px; }.inspected-card > text { display: block; }.preview-detail { margin-top: 25px; padding: 18px; background: #ebe2d1; border-radius: 12px; color: #967947; font-size: 14px; }.abandon-copy { padding: 24px 0; }.confirm-abandon, .exp-dialog .dialog-footer .secondary { width: 100%; min-width: 100%; font-size: 14px; margin-top: 12px; }
@keyframes damageFloat { from { opacity: 1; transform: translateY(8px); } to { opacity: 0; transform: translateY(-16px); } }
@keyframes castPulse { 50% { transform: translateY(-5px) scale(1.09); } }
.scene-back { transform: scale(1.045); }
.scene-middle { animation: alleyMiddle 9s ease-in-out infinite alternate; }
.scene-front { animation: alleyFront 11s ease-in-out infinite alternate; }
@keyframes alleyMiddle { from { transform: translate(-2px,0) scale(1.04); } to { transform: translate(2px,-1px) scale(1.04); } }
@keyframes alleyFront { from { transform: translate(-3px,1px) scale(1.04); } to { transform: translate(3px,-1px) scale(1.04); } }
@media (prefers-reduced-motion: reduce) { .impact, .acting .unit-art, .scene-middle, .scene-front { animation: none; }.health-track view { transition: none; } }
.unit-statuses { position: absolute; right: -3px; top: 31px; display: flex; flex-direction: column; gap: 2px; pointer-events: none; }.ally-unit .unit-statuses { top: 5px; }.unit-statuses text { font-size: 10px; line-height: 15px; min-width: 20px; border-radius: 4px; color: #f9f5e7; background: #647585; padding: 0 2px; }.unit-statuses .status-burn { background: #a76646; }.unit-statuses .status-counter, .unit-statuses .status-retainBlock { background: #4c7967; }.unit-statuses .status-echo, .unit-statuses .status-mark { background: #8c7453; }.compact .hand-hint { padding-top: 4px; }.compact .hand-hint .serif { font-size: 14px; }.compact .hand-hint text { font-size: 10px; line-height: 1.45; margin-top: 3px; }

.exp-log-slot { width: 44px; flex: 0 0 44px; }

.compact .unit-name { font-size: 11px; line-height: 1.2; padding: 0; }

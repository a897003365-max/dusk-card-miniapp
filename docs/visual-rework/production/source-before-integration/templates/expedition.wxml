<template name="expedition">
<view wx:if="{{error}}" class="error">{{error}}</view>
<view wx:elif="{{view}}" class="expedition {{compact ? 'compact' : ''}}">
  <view class="exp-top"><button class="hub-back" bindtap="goHub">‹ 邮局</button><view class="exp-heading"><view>{{run ? run.regionName : view.result.regionName}}</view><text>{{run ? run.difficultyName + ' · 第 ' + (run.layer + 1) + ' / 9 站' : '远行回执'}}</text></view><button wx:if="{{run}}" class="exp-log" bindtap="openLog">记录</button><view wx:else class="exp-log-slot"></view></view>
  <block wx:if="{{run && run.phase === 'battle'}}">
    <view class="battle-toolbar"><view><text class="turn-label">回合 {{run.turn}}</text><text class="energy-label">✦ 能量 {{run.energy}} / 3</text></view><button class="deck-link" bindtap="openDeck">牌库 {{run.drawCount}} · 弃牌 {{run.discardCount}}</button></view>
    <view class="battle-stage">
      <image wx:if="{{art.background}}" class="scene-image scene-back" src="{{art.background}}" mode="aspectFill"/>
      <image wx:if="{{art.middle}}" class="scene-image scene-middle" src="{{art.middle}}" mode="aspectFill"/>
      <view class="stage-light"></view>
      <view class="enemy-row"><view wx:for="{{run.enemies}}" wx:key="id" class="unit enemy-unit {{targetId === item.id ? 'targeted' : ''}}" data-id="{{item.id}}" bindtap="selectEnemy" role="button" aria-label="{{item.name}} {{item.intentText}}">
        <view class="intent-bubble"><block wx:if="{{item.intentEffectLine}}"><view class="intent-target">{{item.intentTargetLine}}</view><view class="intent-effect">{{item.intentEffectLine}}</view></block><view wx:else class="intent-note">{{item.intentNote}}</view></view>
        <image wx:if="{{item.image}}" class="unit-art" src="{{item.image}}" mode="aspectFit"/>
        <view wx:else class="enemy-symbol">✧</view>
        <view class="unit-name">{{item.name}}<text wx:if="{{item.rank === 'boss'}}"> · {{item.phase}}阶</text></view>
        <view class="health-track"><view style="width: {{item.hp / item.maxHp * 100}}%"></view></view>
        <view class="unit-health">{{item.hp}} / {{item.maxHp}}<text wx:if="{{item.block}}"> ⬡{{item.block}}</text></view>
        <view class="unit-statuses"><text wx:for="{{item.statusBadges}}" wx:for-item="badge" wx:key="key" class="status-{{badge.key}}">{{badge.text}}</text></view>
        <view wx:if="{{item.impact}}" class="impact impact-{{item.impactTone}}">{{item.impact}}</view>
      </view></view>
      <view class="versus-line"><text>✦</text></view>
      <view class="party-row"><view wx:for="{{run.party}}" wx:key="id" class="unit ally-unit {{item.down ? 'down' : ''}} {{targetId === item.id ? 'targeted' : ''}} {{item.acting ? 'acting' : ''}}" data-id="{{item.id}}" bindtap="selectAlly" role="button" aria-label="{{item.name}} 生命{{item.hp}} 护盾{{item.block}}">
        <image class="unit-art" src="{{item.image}}" mode="aspectFit"/><view class="unit-name">{{item.name}}</view>
        <view class="health-track"><view style="width: {{item.hp / item.maxHp * 100}}%"></view></view>
        <view class="unit-health">{{item.down ? '暂时倒下' : item.hp + ' / ' + item.maxHp}}<text wx:if="{{item.block}}"> ⬡{{item.block}}</text></view>
        <view class="unit-statuses"><text wx:for="{{item.statusBadges}}" wx:for-item="badge" wx:key="key" class="status-{{badge.key}}">{{badge.text}}</text></view>
        <view wx:if="{{item.impact}}" class="impact impact-{{item.impactTone}}">{{item.impact}}</view>
      </view></view>
      <image wx:if="{{art.front}}" class="scene-image scene-front" src="{{art.front}}" mode="aspectFill"/>
    </view>
    <view class="card-preview">
      <block wx:if="{{selected}}"><view class="preview-title"><view class="preview-main"><text class="serif">{{selected.name}}</text><scroll-view scroll-y class="preview-scroll"><text>{{preview.allowed ? preview.summary : preview.reason}}</text></scroll-view></view><button class="card-detail-link" bindtap="openCard">详情</button></view></block>
      <view wx:else class="hand-hint"><view class="serif">选择一张牌，交给你的旅伴。</view><text>点牌后选目标；再次点牌可取消。点单位查看状态。</text></view>
    </view>
    <scroll-view scroll-x class="hand-scroll" show-scrollbar="{{false}}"><view class="hand-track"><button wx:for="{{run.hand}}" wx:key="uid" class="hand-card role-{{item.role}} {{selected.uid === item.uid ? 'selected-card' : ''}} {{item.playable ? '' : 'unplayable'}}" data-uid="{{item.uid}}" bindtap="selectCard" style="width: {{cardWidth}}px; min-width: {{cardWidth}}px; max-width: {{cardWidth}}px;"><view class="card-cost">{{item.cost}}</view><view class="card-role-icon">{{item.shortDescription}}</view><view class="hand-card-name">{{item.name}}</view><text class="hand-owner">{{item.ownerName}}</text></button></view></scroll-view>
    <view class="battle-actions"><button class="end-turn" disabled="{{busy}}" bindtap="endTurn">结束回合<text>剩余 {{run.energy}} 能量</text></button><button class="confirm-play" disabled="{{busy || !selected || !preview.allowed}}" bindtap="confirmPlay">{{busy ? '正在结算…' : selected ? '确认出牌 · ' + selected.cost + ' 能量' : '先选择手牌'}}</button></view>
  </block>
  <scroll-view wx:elif="{{run}}" scroll-y class="exp-scroll">
    <view class="journey-banner"><view class="eyebrow">{{run.difficultyName}} · 已入库 {{run.threadsEarned}} 星线</view><view class="serif">{{run.phase === 'map' ? '下一封，要往哪里送？' : run.phase === 'cardReward' ? '把这一招带上' : run.phase === 'relicReward' ? '旧物里藏着新办法' : run.phase === 'event' ? run.event.title : run.phase === 'camp' ? '在灯下歇一歇' : '给这张牌添一道光'}}</view><text>{{run.hint}}</text></view>
    <view class="travel-party"><view wx:for="{{run.party}}" wx:key="id"><image src="{{item.image}}" mode="aspectFit"/><text>{{item.name}} {{item.hp}}/{{item.maxHp}}</text></view></view>
    <block wx:if="{{run.phase === 'map'}}"><view class="route-list"><view wx:for="{{run.nodes}}" wx:key="index" class="route-stop {{item.current ? 'current-stop' : ''}} {{item.visited ? 'visited-stop' : ''}}"><view class="route-index">{{item.visited ? '✓' : item.index + 1}}</view><view class="route-content"><view class="route-type">{{item.label}}</view><view class="route-options"><button wx:for="{{item.options}}" wx:for-item="option" wx:key="id" class="route-option" disabled="{{!item.current}}" data-id="{{option.id}}" bindtap="chooseNode"><view>{{option.name}}</view><text>{{option.description}}</text></button></view></view></view></view><button class="abandon-link text-button" bindtap="askAbandon">结束本次远行</button></block>
    <block wx:elif="{{run.phase === 'cardReward'}}"><view class="reward-stack"><view wx:for="{{run.choices}}" wx:key="uid" class="reward-card role-{{item.role}}"><view class="reward-card-head"><text class="tag">{{item.ownerName}}</text><text>✦ {{item.cost}}</text></view><view class="serif reward-name">{{item.name}}</view><text class="reward-copy">{{item.description}}</text><button class="take-card" data-uid="{{item.uid}}" bindtap="chooseCard">收下这张牌</button></view></view><button class="skip-card secondary" bindtap="skipCard">这次不加牌，保持精简</button></block>
    <block wx:elif="{{run.phase === 'relicReward'}}"><view wx:for="{{run.choices}}" wx:key="id" class="relic-choice"><view class="relic-symbol">✧</view><view class="serif reward-name">{{item.name}}</view><text class="reward-copy">{{item.description}}</text><button class="take-relic" data-id="{{item.id}}" bindtap="chooseRelic">带上这件旧物</button></view></block>
    <block wx:elif="{{run.phase === 'event'}}"><view class="event-letter"><text class="body-copy">{{run.event.text}}</text></view><button wx:for="{{run.choices}}" wx:key="id" class="event-choice" data-id="{{item.id}}" bindtap="chooseEvent"><view>{{item.label}}</view><text>{{item.description}}</text></button></block>
    <block wx:elif="{{run.phase === 'camp'}}"><view class="camp-lamp">♧</view><view class="event-letter body-copy">这里的灯还亮着。喝一碗热汤，或请修补师为你改造一张牌。</view><button class="camp-rest" bindtap="rest">全队恢复 35% 最大生命</button><button class="camp-upgrade secondary" bindtap="showUpgrade">升级本局一张牌</button></block>
    <block wx:elif="{{run.phase === 'campUpgrade' || run.phase === 'startingUpgrade'}}"><view wx:for="{{run.choices}}" wx:key="uid" class="upgrade-choice"><view class="row"><view class="serif reward-name">{{item.name}} ＋</view><text class="tag">{{item.ownerName}}</text></view><text class="reward-copy">{{item.upgradeDescription}}</text><button class="upgrade-card" data-uid="{{item.uid}}" bindtap="upgradeCard">选择这张改造</button></view></block>
    <view wx:if="{{run.relics.length}}" class="owned-relics"><view class="serif">随行旧物 · {{run.relics.length}}</view><view wx:for="{{run.relics}}" wx:key="id"><text>{{item.name}}</text><text>{{item.description}}</text></view></view>
  </scroll-view>
  <scroll-view wx:elif="{{view.result}}" scroll-y class="exp-scroll"><view class="exp-result"><view class="result-postmark">{{view.result.win ? '已送达' : '已归队'}}</view><view wx:if="{{view.result.win}}" class="serif">这一程，灯又亮起来了。</view><view wx:else class="serif">回到灯下，<view>再想一个办法。</view></view><text>{{view.result.reason}}</text><view class="result-numbers"><view><text>{{view.result.nodesCleared}} / 9</text>走过的站点</view><view><text>{{view.result.threads}}</text>已入库星线</view><view><text>{{view.result.tickets}}</text>获得邮票</view></view><view class="result-note">本局牌组与旧物留在旅途中，伙伴和已获得的资源会陪你回家。</view><button class="finish-run" bindtap="closeResult">收好回执，回邮局</button></view></scroll-view>
  <view wx:else class="empty">这段邮路已经收好。<button bindtap="goHub">回邮局重新出发</button></view>
</view>
<view wx:if="{{sheet}}" class="overlay exp-overlay" catchtouchmove="noop"><view class="dialog exp-dialog"><view class="dialog-head"><view class="dialog-title serif">{{sheet === 'deck' ? '本局牌组' : sheet === 'log' ? '旅途记录' : sheet === 'enemy' || sheet === 'ally' ? inspected.name : sheet === 'card' ? selected.name : '结束本次远行？'}}</view><button class="close" bindtap="closeSheet" aria-label="关闭">×</button></view>
  <scroll-view scroll-y class="dialog-scroll">
    <block wx:if="{{sheet === 'deck'}}"><view wx:for="{{run.deck}}" wx:key="uid" class="deck-item"><view class="row"><text>{{item.name}}</text><text class="tag">{{item.ownerName}} · {{item.cost}}能量</text></view><text>{{item.description}}</text></view></block>
    <block wx:elif="{{sheet === 'log'}}"><view wx:for="{{run.log}}" wx:key="key" class="log-item">{{item.text}}</view><view wx:if="{{!run.log.length}}" class="empty">这段远行刚刚开始。</view></block>
    <block wx:elif="{{sheet === 'enemy'}}"><view class="inspected-enemy"><image wx:if="{{inspected.image}}" src="{{inspected.image}}" mode="aspectFit"/><view>{{inspected.hp}} / {{inspected.maxHp}} 生命 · {{inspected.block}} 护盾</view><view class="serif">下一次行动</view><text class="body-copy">{{inspected.intentText}}</text><view class="body-copy">{{inspected.statusText || '当前没有额外状态'}}</view></view></block>
    <block wx:elif="{{sheet === 'ally'}}"><view class="inspected-enemy"><image src="{{inspected.image}}" mode="aspectFit"/><view>{{inspected.roleName}} · Lv.{{inspected.level}} · {{inspected.hp}} / {{inspected.maxHp}} 生命</view><view class="serif">{{inspected.passiveName}}</view><text class="body-copy">{{inspected.passiveDescription}}</text><view class="body-copy">{{inspected.statusText || '当前没有额外状态'}}</view></view></block>
    <block wx:elif="{{sheet === 'card'}}"><view class="inspected-card"><view class="tag">{{selected.ownerName}} · {{selected.cost}} 能量</view><text class="body-copy">{{selected.description}}</text><view class="preview-detail">{{preview.allowed ? preview.summary : preview.reason}}</view></view></block>
    <view wx:else class="abandon-copy body-copy">已经入库的星线会保留，本局牌组和遗物会结束。下次可以重新搭配队伍，再走一条不同的路。</view>
  </scroll-view><view wx:if="{{sheet === 'abandon'}}" class="dialog-footer"><button class="confirm-abandon" bindtap="abandon">结束远行，保留已获得资源</button><button class="secondary" bindtap="closeSheet">继续这次远行</button></view>
</view></view>
</template>

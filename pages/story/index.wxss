.story-map .title { font-size: 45rpx; }
.map-intro { font-size: 27rpx; color: #74808d; line-height: 1.8; margin: 18rpx 0 26rpx; }
.map-intro text { display: block; }
.journey-summary { display: flex; justify-content: space-between; color: #6b7c8d; padding: 18rpx 0; border-top: 1rpx solid #dcd8ce; border-bottom: 1rpx solid #dcd8ce; font-size: 22rpx; }
.chapter-list { margin: 32rpx 0; }
.chapter-card { display: flex; gap: 20rpx; }
.chapter-side { width: 45rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; }
.chapter-number { font-family: Georgia,serif; font-size: 33rpx; color: #a8875d; margin-top: 27rpx; }
.route-line { width: 1rpx; flex: 1; border-left: 2rpx dashed #cfc6b6; margin: 16rpx 0; }
.chapter-main { flex: 1; min-width: 0; padding: 24rpx; border: 1rpx solid #d8d8d2; border-radius: 22rpx; background: #fffcf6; margin-bottom: 24rpx; }
.chapter-place { font-size: 18rpx; letter-spacing: 4rpx; color: #8d795e; }
.chapter-title { font-size: 36rpx; margin-top: 7rpx; }
.guide-art { width: 105rpx; height: 105rpx; flex-shrink: 0; }
.chapter-subtitle { font-size: 23rpx; color: #52677f; margin-top: 8rpx; }
.chapter-description { font-size: 24rpx; line-height: 1.8; color: #7f8892; margin-top: 15rpx; }
.chapter-reward { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8rpx; font-size: 18rpx; color: #a48252; margin: 24rpx 0 18rpx; }
.chapter-start { font-size: 24rpx; padding: 21rpx 14rpx; border-radius: 12rpx; min-height: 44px; }
.locked .chapter-main { background: #eeeee8; }
.locked-guide { opacity: .45; filter: grayscale(1); }
.locked .chapter-title { color: #858d93; }
.locked .chapter-description { color: #999e9f; }
.keepsake { display: flex; justify-content: space-between; padding: 22rpx 0 10rpx; border-bottom: 1rpx solid #e9e4d9; font-size: 26rpx; }
.story-help-toggle { width: 100%; font-size: 12px; }
.reader-top { display: flex; justify-content: space-between; align-items: center; }
.reading-progress { height: 5rpx; background: #e4e0d6; margin: 22rpx 0 25rpx; border-radius: 5rpx; overflow: hidden; }
.reading-progress view { height: 100%; background: #aa8251; }
.reader-chapter { color: #8a795f; font-size: 22rpx; }
.reader-title { font-size: 47rpx; margin-top: 10rpx; margin-bottom: 24rpx; }
.scene-window { background: linear-gradient(140deg,#3e5972,#899391); height: 245rpx; position: relative; border-radius: 90rpx 90rpx 14rpx 14rpx; overflow: hidden; }
.window-ring { width: 480rpx; height: 480rpx; border: 1rpx solid #d3ddcb55; position: absolute; left: -45rpx; top: 30rpx; border-radius: 50%; }
.window-hill { width: 600rpx; height: 230rpx; border-radius: 50%; position: absolute; transform: rotate(-12deg); }
.hill-back { background: #657d7b; left: -100rpx; bottom: -155rpx; }
.hill-front { background: #334f5f; right: -165rpx; bottom: -140rpx; transform: rotate(15deg); }
.window-moon { width: 61rpx; height: 61rpx; background: #ecd7a5; border-radius: 50%; position: absolute; top: 42rpx; left: 83rpx; box-shadow: 0 0 50rpx #e7d2a337; }
.window-spark { color: #ebd9ac; position: absolute; left: 186rpx; top: 48rpx; font-size: 29rpx; }
.scene-guide { width: 200rpx; height: 200rpx; position: absolute; right: 71rpx; top: 18rpx; }
.scene-location { position: absolute; bottom: 20rpx; left: 30rpx; right: 20rpx; font-size: 18rpx; color: #dde0cf; letter-spacing: 2rpx; }
.letter-page { padding: 25rpx 3rpx 4rpx; }
.speaker { color: #9f8057; font-size: 26rpx; font-weight: 600; margin-bottom: 15rpx; }
.speaker text { font-weight: 400; font-size: 20rpx; margin-left: 8rpx; color: #9aa0a2; }
.scene-text { display: block; font-size: 15px; line-height: 1.95; }
.reader-party { display: flex; align-items: center; justify-content: space-between; border-top: 1rpx dashed #d6d1c7; border-bottom: 1rpx dashed #d6d1c7; padding: 12rpx 0; margin: 25rpx 0; }
.mini-partners { display: flex; }
.mini-partners image { width: 59rpx; height: 59rpx; }
.reader-stats { display: flex; gap: 18rpx; font-size: 21rpx; color: #6e7f8e; }
.choice-question { font-size: 28rpx; margin-bottom: 17rpx; }
.choice-button { margin-top: 15rpx; background: #fffcf6; color: #314962; text-align: left; border: 1rpx solid #d7d6cc; border-radius: 16rpx; padding: 23rpx; font-weight: 500; }
.choice-text { font-size: 29rpx; }
.choice-arrow { font-size: 31rpx; font-weight: 400; }
.choice-condition { margin-top: 12rpx; font-size: 20rpx; color: #7f8b92; font-weight: 400; }
.choice-condition text { color: #aa8053; float: right; }
.save-note { color: #9b9f9f; text-align: center; font-size: 19rpx; margin: 26rpx 0 8rpx; }
.outcome { margin-top: 26rpx; background: #f0ecdf; }
.outcome-eyebrow { color: #8d6b43; font-size: 28rpx; font-weight: 600; }
.outcome-score { font-size: 21rpx; color: #939a97; margin: 8rpx 0 17rpx; }
.outcome-text { display: block; }
.choice-memory { border-top: 1rpx solid #dbd4c2; padding-top: 18rpx; margin-top: 22rpx; font-size: 23rpx; color: #a08d6d; }
.continue-story { color: #f5dcb4; min-height: 48px; }
.ending-dialog { border: 6rpx double #c5b391; }
.ending-dialog .eyebrow { font-size: 14rpx; letter-spacing: 2rpx; }
.ending-seal { width: 93rpx; height: 93rpx; line-height: 86rpx; border: 5rpx double #b88655; color: #996841; border-radius: 50%; text-align: center; font-size: 45rpx; margin: 20rpx auto 26rpx; transform: rotate(-14deg); }
.ending-title { font-size: 40rpx; text-align: center; margin-bottom: 24rpx; }
.ending-text { display: block; font-size: 14px; }
.ending-reward { margin-top: 28rpx; padding: 23rpx 10rpx; text-align: center; background: #efe7d5; color: #926f44; border-radius: 12rpx; font-size: 27rpx; }
.ending-reward text { display: block; }
.ending-reward text + text { font-size: 22rpx; margin-top: 8rpx; }
.ending-caption { text-align: center; color: #92968f; font-size: 21rpx; margin: 18rpx 0 0; }
.archive-link { width: 100%; font-size: 22rpx; margin-top: 8rpx; }
.archived-letter { padding: 28rpx 0; }
.archived-letter + .archived-letter { border-top: 1rpx dashed #cfbda0; }
.archive-tone { font-size: 21rpx; color: #a58960; }
.archived-title { margin: 10rpx 0 18rpx; font-size: 34rpx; }
.story-reader { padding-bottom: 250px; }
.story-reader.has-feedback { padding-bottom: 125px; }
.reader-actions { position: fixed; z-index: 5; bottom: 0; left: 0; right: 0; padding: 16rpx 36rpx 12rpx; border-top: 1rpx solid #ded8cb; background: #f8f4ed; box-shadow: 0 -10rpx 25rpx #26385108; }
.reader-actions .choice-question { font-size: 14px; margin-bottom: 8rpx; }
.reader-actions .choice-button { padding: 16rpx 22rpx; margin-top: 10rpx; min-height: 62px; }
.reader-actions .choice-text { font-size: 15px; }
.reader-actions .choice-condition { font-size: 11px; margin-top: 8rpx; }
.reader-actions .save-note { font-size: 10px; margin: 12rpx 0 0; }
.chapter-reward, .reader-stats, .scene-location { font-size: 11px; }
.reader-actions .continue-story { padding: 19rpx 24rpx; }
.choice-button, .chapter-start, .continue-story { width: 100%; min-width: 100%; }

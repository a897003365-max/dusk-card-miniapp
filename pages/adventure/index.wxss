.adventure-hub .title { font-size: 44rpx; }.hub-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }.hub-intro { font-size: 12px; color: #778391; }.thread-wallet { flex-shrink: 0; font-size: 13px; color: #a67c42; font-weight: 600; }.resume-card { margin-top: 25px; border: 1px solid #c6b891; padding: 18px; border-radius: 16px; background: #ede5d5; }.resume-card .serif { font-size: 22px; margin: 8px 0; }.resume-run { margin-top: 16px; min-width: 100%; }.story-busy { margin-top: 22px; font-size: 14px; }.story-busy button { margin-top: 16px; width: 100%; min-width: 100%; }.region-tabs { display: flex; gap: 8px; }.region-tab { width: 0; flex: 1; min-width: 0; font-size: 13px; border-radius: 12px; padding: 11px 5px; color: #718092; background: #e9e5dd; }.region-tab.active { color: #fff7e8; background: #34475d; }.region-tab text { display: block; font-size: 10px; font-weight: 400; margin-top: 5px; }.region-cover { position: relative; height: 220px; border-radius: 90px 90px 18px 18px; overflow: hidden; margin-top: 18px; background: linear-gradient(155deg,#466777,#263851); }.region-bridge { background: linear-gradient(155deg,#53627d,#1a3045); }.region-market { background: linear-gradient(155deg,#7c5660,#283752); }.region-cover image { width: 100%; height: 100%; position: absolute; }.region-cover-shade { position: absolute; inset: 0; background: linear-gradient(180deg,#1c2d4300,#122138b8); }.region-cover-copy { position: absolute; left: 24px; bottom: 24px; right: 70px; color: #fff0d4; }.region-cover-copy .eyebrow { color: #d5c49e; letter-spacing: 2px; font-size: 11px; }.region-cover-copy .serif { font-size: 30px; margin: 9px 0; }.region-cover-copy text { font-size: 12px; line-height: 1.8; }.cover-seal { position: absolute; right: 16px; bottom: 24px; width: 45px; height: 60px; border: 2px double #c3ad7c; padding: 8px 5px; color: #e4cfa0; font-size: 13px; text-align: center; transform: rotate(6deg); }.difficulty-tabs { display: flex; gap: 8px; margin-top: 20px; }.difficulty-tab { width: 0; flex: 1; min-width: 0; padding: 10px 4px; background: #ede8de; color: #77808a; font-size: 14px; }.difficulty-tab.active { background: #dac7a2; color: #514435; }.difficulty-tab text { display: block; font-size: 10px; font-weight: 400; margin-top: 5px; }.difficulty-description { font-size: 12px; color: #7c8792; margin: 13px 0; line-height: 1.8; }.affix { font-size: 12px; color: #97674a; background: #eee2d3; padding: 8px 10px; margin-top: 7px; border-radius: 8px; }.party-title { display: flex; align-items: center; justify-content: space-between; margin-top: 22px; font-size: 22px; }.party-title button { font-size: 12px; min-width: 0; width: auto; max-width: 130px; }.hub-party { display: flex; gap: 10px; }.hub-member { flex: 1; min-width: 0; text-align: center; border: 1px solid #ded8cc; border-radius: 12px; background: #fffbf3; padding: 8px 3px 12px; font-size: 12px; }.hub-member image { width: 72px; height: 72px; max-width: 100%; }.hub-member text { display: block; font-size: 10px; color: #8c7858; margin-top: 5px; }.start-run { margin-top: 22px; width: 100%; min-width: 100%; min-height: 50px; color: #f5dcaa; }.hub-rules { text-align: center; font-size: 11px; color: #85909a; line-height: 1.9; margin-top: 15px; }.last-result { margin-top: 25px; }.last-result .serif { font-size: 22px; }.last-result text { display: block; font-size: 12px; margin-top: 10px; color: #8b785c; }
.adventure-hub { padding-bottom: 112px; }.hub-actions { position: fixed; bottom: 0; left: 0; right: 0; z-index: 5; padding: 9px 18px 12px; background: #f8f4ed; border-top: 1px solid #d9d0bd; }.dock-copy { text-align: center; font-size: 11px; color: #8b806f; margin-bottom: 7px; }.hub-actions .start-run, .hub-actions .resume-run { width: 100%; min-width: 100%; min-height: 48px; margin: 0; font-size: 14px; color: #f2d5a1; }

.tactic-panel { margin-top: 24px; padding: 16px 13px; background: #fffbf3; border: 1px solid #d9ccaf; border-radius: 14px; }
.tactic-heading { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.tactic-heading .serif { color: #424f5b; font-size: 19px; }
.tactic-heading text:last-child { color: #8b785c; font-size: 10px; }
.tactic-tabs { display: flex; gap: 6px; margin-top: 14px; }
.tactic-tab { flex: 1; width: 0; min-width: 0; max-width: none; min-height: 46px; padding: 10px 3px; margin: 0; border: 1px solid #d7cbb4; border-radius: 8px; background: #f0eadf; color: #776750; font-size: 12px; line-height: 24px; }
.tactic-active { color: #fff6df; background: #42576b; border-color: #42576b; }
.tactic-summary { margin-top: 13px; font-size: 12px; line-height: 1.9; color: #586575; }
.tactic-card { margin-top: 11px; padding-top: 11px; border-top: 1px solid #ece1ce; }
.tactic-card-title { display: flex; gap: 9px; align-items: center; font-size: 13px; color: #4c5660; }
.tactic-cost { min-width: 34px; padding: 2px 4px; border-radius: 5px; background: #e9ddc2; color: #7b602e; text-align: center; font-size: 11px; }
.tactic-card-copy { display: block; margin-top: 6px; color: #7a7166; font-size: 11px; line-height: 1.9; }
.tactic-note { margin-top: 12px; font-size: 10px; line-height: 1.9; color: #938574; }
.tactic-snapshot { margin-top: 20px; font-size: 13px; color: #746349; }
.tactic-snapshot text { display: block; margin-top: 6px; font-size: 11px; color: #918677; }

.tactic-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.tactic-tabs .tactic-tab { width: 100%; padding: 10px 6px; font-size: 13px; }
.tactic-card-title { flex-wrap: wrap; }
.tactic-owner { margin-left: auto; font-size: 10px; color: #8d795f; }

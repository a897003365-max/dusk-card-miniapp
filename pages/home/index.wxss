@import "./summon.wxss";
.masthead { display: flex; align-items: center; justify-content: space-between; margin: 0 0 26rpx; }
.brand { font-size: 43rpx; letter-spacing: 6rpx; margin-top: 5rpx; }
.ticket-wallet { border: 1rpx solid #d9d5cb; border-radius: 12rpx; padding: 12rpx 20rpx; font-size: 32rpx; font-weight: 700; background: #fffcf6; }
.ticket-mark { color: #b98c4e; margin-right: 6rpx; }
.post-office { background: linear-gradient(150deg,#344b68,#202e45 65%,#37435b); border-radius: 160rpx 160rpx 28rpx 28rpx; height: 720rpx; position: relative; overflow: hidden; text-align: center; color: #f7ebd4; padding-top: 56rpx; }
.office-backdrop, .office-shade { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }.office-shade { background: linear-gradient(#14233344,#14233377 56%,#14233399); }
.office-label { font-size: 20rpx; letter-spacing: 4rpx; color: #cbbfa7; position: relative; }
.hero-title { font-size: 49rpx; line-height: 1.35; letter-spacing: 3rpx; margin-top: 21rpx; position: relative; }
.hero-subtitle { position: relative; color: #d1d5d7; font-size: 23rpx; letter-spacing: 3rpx; margin-top: 18rpx; }
.orbit { position: absolute; border: 1rpx solid rgba(229,211,175,.14); border-radius: 50%; width: 880rpx; height: 880rpx; left: -100rpx; top: 80rpx; transform: rotate(-28deg) scaleX(.8); }
.orbit-two { top: 150rpx; left: -150rpx; transform: rotate(30deg) scaleX(.7); }
.star { position: absolute; color: #d9bb82; }.star-one { left: 62rpx; top: 190rpx; font-size: 30rpx; }.star-two { right: 61rpx; top: 294rpx; font-size: 24rpx; }.star-three { right: 104rpx; top: 154rpx; font-size: 60rpx; }
.letter-display { position: absolute; top: 300rpx; width: 100%; height: 355rpx; }
.stamp-card { position: absolute; width: 194rpx; background: #f6ecd6; color: #5b5d68; padding: 11rpx; border: 5rpx solid #e6d3ad; outline: 1rpx dashed #ac9976; outline-offset: -11rpx; border-radius: 6rpx; box-shadow: 0 12rpx 35rpx #10213755; }
.stamp-left { left: 63rpx; top: 49rpx; transform: rotate(-17deg); }.stamp-right { right: 57rpx; top: 48rpx; transform: rotate(16deg); background: #e7e4ef; border-color: #d4cadf; }.stamp-center { width: 223rpx; top: 0; left: 50%; transform: translateX(-50%) rotate(-3deg); z-index: 2; }
.stamp-top { display: flex; justify-content: space-between; font-size: 20rpx; font-weight: 700; padding: 2rpx 5rpx; }.stamp-top text { color: #8f8c80; font-size: 18rpx; }
.stamp-art { display: block; width: 156rpx; height: 156rpx; margin: 0 auto; }.stamp-center .stamp-art { width: 181rpx; height: 181rpx; }.stamp-name { font-size: 23rpx; font-weight: 600; }.stamp-caption { font-size: 10rpx; letter-spacing: 2rpx; margin-top: 5rpx; }
.envelope { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%) rotate(2deg); z-index: 3; width: 450rpx; height: 139rpx; min-height: 44px; padding: 0; background: #d9bf94; border: 2rpx solid #e9d5b3; border-radius: 5rpx 5rpx 14rpx 14rpx; overflow: hidden; box-shadow: 0 15rpx 28rpx #10213755; }.envelope[disabled] { background: #d9bf94; opacity: .6; }
.envelope-line { width: 325rpx; height: 325rpx; position: absolute; left: 61rpx; top: -246rpx; transform: rotate(45deg); background: #e6d1ae; border-right: 2rpx solid #c6ab81; border-bottom: 2rpx solid #c6ab81; }
.wax-seal { width: 65rpx; height: 65rpx; line-height: 58rpx; border: 5rpx double #b06551; background: #b7735c; color: #f0cdb0; position: absolute; left: 193rpx; top: 22rpx; border-radius: 50%; font-size: 33rpx; }
.envelope-label { position: absolute; bottom: 8rpx; width: 100%; font-size: 11px; letter-spacing: 1rpx; color: #6c5433; }
.office-footer { position: absolute; bottom: 14rpx; left: 0; right: 0; font-size: 11px; letter-spacing: 1rpx; color: #c8c7bf; }
.draw-panel { padding: 28rpx 0 20rpx; }.draw-title { font-size: 29rpx; }.draw-buttons { display: flex; gap: 18rpx; margin: 22rpx 0 17rpx; }.draw-buttons button { flex: 1; font-size: 31rpx; padding: 19rpx 16rpx; border-radius: 16rpx; }.draw-buttons text { display: block; font-size: 20rpx; font-weight: 400; margin-top: 6rpx; }.draw-one { background: #eae4d8; color: #3f4d5d; }.draw-five { background: #263851; color: #f3dfb9; }.pity { display: flex; justify-content: space-between; gap: 8rpx; flex-wrap: wrap; color: #77818b; font-size: 12px; }.no-ticket { padding-top: 20rpx; color: #8c6245; font-size: 23rpx; }
.journey-teaser { display: flex; align-items: center; gap: 18rpx; border-top: 1rpx solid #ded9cf; border-bottom: 1rpx solid #ded9cf; padding: 27rpx 0; margin-top: 10rpx; }.teaser-number { writing-mode: vertical-rl; font-size: 18rpx; letter-spacing: 3rpx; color: #9b9d9d; }.teaser-copy { flex: 1; }.teaser-copy .eyebrow { font-size: 13rpx; letter-spacing: 2rpx; }.teaser-title { font-size: 33rpx; margin: 7rpx 0; }.teaser-arrow { font-size: 44rpx; color: #52677f; }
.teaser-action { color: #52677f; font-size: 13px; font-weight: 600; }
.rules-toggle { width: 100%; margin-top: 13rpx; font-size: 22rpx; }.home-footnote { text-align: center; font-size: 20rpx; color: #9a9c9c; margin-top: 20rpx; }
.reveal-dialog { height: auto; max-height: calc(100vh - 24px); padding: 24rpx; overflow: hidden; }
.reveal-heading { min-width: 0; padding-right: 10rpx; }.reveal-heading .eyebrow { font-size: 15rpx; letter-spacing: 3rpx; }.reveal-dialog .dialog-title { font-size: 32rpx; line-height: 1.45; margin-top: 5rpx; }.reveal-dialog .close { width: 44px; height: 44px; min-width: 44px; min-height: 44px; line-height: 42px; font-size: 28px; }
.reveal-progress { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; padding: 10rpx 0 12rpx; font-size: 12px; line-height: 1.5; color: #77818b; flex-shrink: 0; }.reveal-count { color: #8a6b41; white-space: nowrap; }
.reveal-dialog .result-scroll { height: 43vh; flex: none; max-height: none; min-height: 0; }
.result-grid { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 6rpx 0 12rpx; }.result-card { width: calc((100% - 16rpx) / 2); height: 390rpx; min-width: 0; text-align: center; border: 1rpx solid #d8d0c2; border-radius: 12rpx; overflow: hidden; }
.is-sealed { background: #e9d4af; border-color: #cdb78f; }.sealed-letter { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; min-height: 44px; min-width: 100%; max-width: 100%; margin: 0; padding: 12rpx; border-radius: 0; background: #e9d4af; color: #725c3c; font-weight: 400; overflow: hidden; }
.sealed-top { position: absolute; top: 14rpx; left: 16rpx; right: 16rpx; display: flex; justify-content: space-between; font-size: 10px; letter-spacing: 1rpx; z-index: 1; }.sealed-flap { position: absolute; width: 240rpx; height: 240rpx; top: -158rpx; left: 50%; margin-left: -120rpx; transform: rotate(45deg); border-right: 1rpx solid #c9ad7e; border-bottom: 1rpx solid #c9ad7e; background: #f2e2c6; }.sealed-postmark { position: absolute; right: 16rpx; top: 62rpx; border: 1rpx solid #b29c76; border-radius: 50%; padding: 8rpx 4rpx; color: #9c8867; font-size: 9px; transform: rotate(14deg); }
.letter-seal { display: flex; align-items: center; justify-content: center; width: 60px; height: 60px; margin: 10rpx 0 14rpx; border-radius: 50%; border: 4px double #c6886c; background: #995b4d; color: #f0ce9b; box-shadow: 0 3px 0 #75443a, 0 7px 12px #77584426; font-size: 31px; position: relative; }.seal-hint { font-size: 12px; line-height: 1.5; color: #715a3b; position: relative; }.sealed-to { position: absolute; bottom: 12rpx; font-size: 7px; letter-spacing: 1rpx; color: #9f8965; }
.revealed-letter { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; padding: 14rpx 12rpx; animation: unseal 380ms ease-out both; transform-origin: left center; }.revealed-letter .row { width: 100%; gap: 6rpx; }.revealed-letter .tag { font-size: 11px; padding: 3rpx 8rpx; }.new-tag { font-size: 10px; white-space: nowrap; }.result-art { display: block; flex-shrink: 0; width: 148rpx; height: 148rpx; margin: 6rpx auto; }.result-name { font-size: 16px; line-height: 1.35; margin-bottom: 6rpx; }.result-card .small { font-size: 11px; line-height: 1.5; }
.single-result { justify-content: center; }.single-result .result-card { width: 90%; height: 40vh; max-height: 460rpx; }.single-result .result-art { width: 18vh; height: 18vh; max-width: 210rpx; max-height: 210rpx; }.single-result .result-name { font-size: 23px; }.single-result .small { font-size: 12px; }.single-result .letter-seal { width: 72px; height: 72px; font-size: 38px; }.single-result .sealed-flap { width: 420rpx; height: 420rpx; margin-left: -210rpx; top: -280rpx; }
.reveal-dialog .dialog-footer { margin-top: 16rpx; }.reveal-actions { display: flex; gap: 14rpx; }.reveal-actions button { flex: 1; min-width: 0; min-height: 44px; padding: 11px 8px; font-size: 14px; border-radius: 12rpx; }.reveal-all { background: #ece3d3; color: #6f593b; }.result-saved { text-align: center; font-size: 11px; line-height: 1.5; color: #77818b; margin-top: 10rpx; }
@keyframes unseal { from { opacity: 0; transform: perspective(600px) rotateY(-45deg); } to { opacity: 1; transform: perspective(600px) rotateY(0deg); } }
@media (max-height: 500px) { .reveal-dialog .result-scroll { height: 40vh; }.single-result .result-card { height: 37vh; }.single-result .result-art { width: 16vh; height: 16vh; }.single-result .letter-seal { width: 60px; height: 60px; font-size: 31px; } }
@media (prefers-reduced-motion: reduce) { .revealed-letter { animation: none; } }

.summon-overlay { position: fixed; inset: 0; z-index: 80; display: flex; flex-direction: column; overflow: hidden; padding: 10px 18px 12px; background: #151e2d; color: #f9ecd7; box-sizing: border-box; }
.summon-backdrop { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.summon-shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(#10172455,#10172416 28%,#10172426 62%,#101724c4),radial-gradient(ellipse at 50% 42%,transparent 30%,#10172444); }
.summon-header { position: relative; z-index: 5; height: 48px; flex: 0 0 48px; display: flex; align-items: center; justify-content: space-between; }
.summon-counter { font-size: 14px; color: #ecd7b5; }.summon-counter text { margin-left: 8px; font-size: 12px; color: #a6b0b8; }
.summon-close { margin-left: 0 !important; margin-right: 0 !important; flex: 0 0 44px; width: 44px; min-width: 44px; max-width: 44px; height: 44px; min-height: 44px; padding: 0; background: #e0d7c316; color: #f1e3cd; border: 1px solid #d0be963b; font-size: 28px; line-height: 40px; border-radius: 50%; }
.summon-center { position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.summon-field { position: absolute; width: 600rpx; height: 600rpx; max-width: 95vw; max-height: 95vw; top: 44%; left: 50%; transform: translate(-50%,-50%); pointer-events: none; }
.summon-halo { position: absolute; inset: 3%; border-radius: 50%; background: radial-gradient(ellipse,var(--summon-ink) 0%,transparent 68%); opacity: .13; transform: scale(.8); }
.summon-ring { position: absolute; left: 50%; top: 50%; width: 78%; height: 78%; border: 1px solid var(--summon-ink); border-radius: 50%; transform: translate(-50%,-50%) rotate(-28deg); opacity: .15; }
.ring-inner { width: 62%; height: 62%; border: 1px dashed var(--summon-light); transform: translate(-50%,-50%) rotate(20deg); }
.summon-SR .ring-outer { border-radius: 38% 62% 39% 61%; transform: translate(-50%,-50%) rotate(-25deg); }
.summon-SR .ring-inner { border-radius: 60% 40% 60% 40%; transform: translate(-50%,-50%) rotate(25deg); }
.summon-compass { position: absolute; inset: 10%; transform: rotate(45deg); opacity: .45; }
.summon-compass view { position: absolute; width: 18rpx; height: 18rpx; border: 1px solid var(--summon-light); background: #222338; }
.summon-compass view:nth-child(1) { top: 0; left: 0; }.summon-compass view:nth-child(2) { top: 0; right: 0; }.summon-compass view:nth-child(3) { bottom: 0; right: 0; }.summon-compass view:nth-child(4) { bottom: 0; left: 0; }
.summon-eclipse { position: absolute; width: 51%; height: 51%; top: 50%; left: 50%; border-radius: 50%; background: #151923; border: 2px solid #e7b768; box-shadow: 0 0 20rpx #f4c36b99,0 0 65rpx #ef85483b,inset 0 0 40rpx #242c38; transform: translate(-50%,-50%); }
.summon-orbit { position: absolute; left: 50%; top: 50%; width: 91%; height: 46%; border: 1px solid var(--summon-light); border-radius: 50%; opacity: .25; transform: translate(-50%,-50%) rotate(-28deg); }
.orbit-west { transform: translate(-50%,-50%) rotate(38deg); border-color: var(--summon-ink); }
.summon-rays, .summon-particles { position: absolute; inset: 0; }
.ray-axis, .particle-axis { position: absolute; left: 50%; top: 50%; width: 0; height: 0; }
.summon-ray { position: absolute; bottom: 0; left: -2rpx; transform-origin: center bottom; background: linear-gradient(transparent,var(--summon-ink)); opacity: 0; transform: scaleY(0); border-radius: 50%; }
.summon-particle { position: absolute; left: -3rpx; bottom: 0; background: var(--summon-ink); border-radius: 1px; opacity: 0; }
.summon-SSR .summon-particle, .summon-UR .summon-particle { border-radius: 50%; height: 5rpx; box-shadow: 0 0 5rpx var(--summon-light); }
.summon-shockwave { position: absolute; inset: 26%; border-radius: 50%; border: 4px solid var(--summon-light); opacity: 0; }
.summon-letter { position: absolute; left: 50%; top: 43%; width: 410rpx; max-width: 76vw; height: 266rpx; max-height: 27vh; transform: translate(-50%,-50%) rotate(-4deg); border: 1px solid #decda5; border-radius: 6rpx; background: linear-gradient(150deg,#efdfbd,#c9ad7d); box-shadow: 0 20rpx 60rpx #0006,inset 0 0 0 10rpx #f4e7ce55; overflow: hidden; }
.summon-fold { position: absolute; width: 74%; height: 120%; top: 18%; border: 1px solid #b69c72; background: #e0c79a; }.fold-left { left: -29%; transform: rotate(37deg); }.fold-right { right: -29%; transform: rotate(-37deg); }.fold-top { left: 13%; top: -99%; transform: rotate(45deg); background: #f5e5c9; }
.summon-wax { position: absolute; top: 29%; left: 50%; transform: translateX(-50%); width: 100rpx; height: 100rpx; max-width: 58px; max-height: 58px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 5rpx double #d29471; color: #f5d496; background: #924f40; box-shadow: 0 5rpx 0 #603b34,0 9rpx 12rpx #5a382b55; }
.wax-star { font-size: 42rpx; line-height: 1; }.letter-address { position: absolute; left: 0; bottom: 15rpx; width: 100%; color: #775d3e; text-align: center; font-size: 12px; letter-spacing: 3px; }
.summon-anticipation { position: absolute; top: 78%; width: 100%; text-align: center; font-size: 18px; letter-spacing: 3px; color: var(--summon-ink); }
.summon-anticipation text { display: block; margin-top: 10px; font-size: 12px; letter-spacing: 1px; color: #c4c0b5; }
.summon-reveal { position: relative; z-index: 2; width: 100%; text-align: center; display: flex; flex-direction: column; align-items: center; opacity: 1; transform: none; }
.summon-rank { display: flex; align-items: center; justify-content: center; gap: 15px; color: var(--summon-ink); height: 38px; letter-spacing: 6px; font-size: 22px; font-weight: 700; }.rank-rule { width: 46px; height: 1px; background: linear-gradient(90deg,transparent,var(--summon-ink),transparent); }
.summon-portrait { position: relative; width: 82%; max-width: 330px; height: 42vh; max-height: 340px; min-height: 120px; margin: 8px auto 10px; display: flex; align-items: center; justify-content: center; }
.portrait-arch { position: absolute; inset: 1% 8% 5%; border: 1px solid var(--summon-ink); border-radius: 48% 48% 8px 8px; background: linear-gradient(#0e1a2633,#51656b27); box-shadow: inset 0 0 0 5px #192534,inset 0 0 0 6px #e3c99835; }
.portrait-floor { position: absolute; width: 82%; height: 22%; bottom: 0; border-radius: 50%; background: radial-gradient(ellipse,var(--summon-ink),transparent 68%); opacity: .18; }
.summon-character { position: relative; z-index: 2; width: 91%; height: 100%; filter: drop-shadow(0 8px 8px #0006); }
.portrait-corner { position: absolute; bottom: 2%; width: 24rpx; height: 24rpx; border-top: 1px solid var(--summon-ink); border-left: 1px solid var(--summon-ink); transform: rotate(45deg); }.corner-left { left: 6%; }.corner-right { right: 6%; }
.summon-name { font-size: 28px; line-height: 1.35; letter-spacing: 2px; color: #f7ead0; }
.summon-meeting { margin-top: 8px; color: var(--summon-ink); font-size: 13px; letter-spacing: 2px; }
.summon-footer { position: relative; z-index: 5; flex: 0 0 120px; width: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; }
.summon-next, .summon-skip { display: block; width: 100%; min-width: 100%; max-width: 100%; min-height: 44px; padding: 11px 14px; margin: 0; border-radius: 8px; font-size: 15px; color: #1e2b37; background: var(--summon-ink); border: 1px solid var(--summon-light); }
.summon-skip { width: 160px; min-width: 160px; max-width: 160px; color: #dfd5c4; background: #e1d4b20d; border-color: #b6a88b66; }
.summon-back { min-width: 160px; max-width: 160px; padding: 8px 12px; min-height: 44px; width: 160px; margin: 0; background: transparent; color: #c4b8a3; font-size: 13px; }
.summon-saved { font-size: 11px; line-height: 1.5; text-align: center; color: #a0a9ad; margin-top: 5px; }
.phase-charge .summon-halo { animation: summonGather var(--charge-time) ease-in both; }.phase-charge .summon-wax { animation: waxGather var(--charge-time) ease-in both; }
.phase-charge .summon-particle { animation: paperGather var(--charge-time) ease-in both; }
.phase-charge .summon-ring { animation: ringGather var(--charge-time) ease-in both; }
.phase-charge .summon-eclipse { animation: eclipseGather var(--charge-time) ease-in both; }
.phase-burst .summon-letter { animation: letterBurst var(--burst-time) ease-out both; }
.phase-burst .summon-halo { animation: summonBloom var(--burst-time) ease-out both; }
.phase-burst .summon-shockwave { animation: sealWave var(--burst-time) ease-out both; }
.phase-burst .summon-particle, .phase-arrive .summon-particle { animation: paperScatter 750ms ease-out both; }
.phase-burst .summon-ray, .phase-arrive .summon-ray { animation: rayBloom 700ms ease-out both; }
.phase-burst .summon-ring { opacity: .8; }.phase-burst .summon-eclipse { opacity: 0; transform: translate(-50%,-50%) scale(1.7); transition: transform var(--burst-time) ease,opacity var(--burst-time) ease; }
.summon-UR.phase-burst .summon-letter { animation: eclipseSeal var(--burst-time) cubic-bezier(.3,.05,.3,1) both; }
.summon-UR.phase-burst .summon-eclipse { animation: eclipseUnveil var(--burst-time) ease-out both; transition: none; }
.phase-arrive .summon-letter, .phase-settled .summon-letter { display: none; }
.phase-arrive .summon-reveal { animation: companionArrive var(--arrive-time) cubic-bezier(.14,.7,.24,1) both; }
.phase-settled .summon-reveal { animation: none; opacity: 1; transform: none; }
.phase-arrive .summon-eclipse, .phase-settled .summon-eclipse { opacity: .12; box-shadow: none; }
.phase-arrive .summon-halo { opacity: .25; transform: scale(1.1); transition: opacity var(--arrive-time) ease; }
.phase-settled .summon-halo { opacity: .12; transform: scale(1); }
.phase-settled .summon-compass, .phase-settled .summon-ring { opacity: .16; }.phase-settled .summon-orbit { opacity: .14; }
.summon-UR.phase-arrive .summon-orbit { animation: eclipseOrbit var(--arrive-time) ease-out both; }
.summon-SR.phase-arrive .summon-ring { animation: petalOpen var(--arrive-time) ease-out both; }
.summon-SSR.phase-arrive .summon-compass { animation: compassOpen var(--arrive-time) ease-out both; }
@keyframes summonGather { from { opacity: .08; transform: scale(1.2); } to { opacity: .55; transform: scale(.52); } }
@keyframes waxGather { from { box-shadow: 0 5rpx 0 #603b34; } to { box-shadow: 0 0 35rpx var(--summon-ink),0 0 80rpx var(--summon-light); } }
@keyframes ringGather { from { opacity: .08; width: 92%; height: 92%; } to { opacity: .7; width: 54%; height: 54%; } }
@keyframes paperGather { from { opacity: 0; transform: translateY(calc(-1 * var(--travel))) rotate(50deg); } 30% { opacity: .7; } to { opacity: 0; transform: translateY(0) rotate(0); } }
@keyframes eclipseGather { from { transform: translate(-50%,-50%) scale(.5); opacity: .2; } to { transform: translate(-50%,-50%) scale(1.15); opacity: 1; } }
@keyframes letterBurst { 0% { opacity: 1; transform: translate(-50%,-50%) rotate(-4deg) scale(1); } 35% { opacity: 1; transform: translate(-50%,-50%) rotate(0) scale(1.1); } 100% { opacity: 0; transform: translate(-50%,-50%) rotate(4deg) scale(1.7); } }
@keyframes eclipseSeal { 0% { opacity: 1; transform: translate(-50%,-50%) rotate(-4deg) scale(1); } 30% { opacity: 1; transform: translate(-50%,-50%) rotate(18deg) scale(.12); } 38%,100% { opacity: 0; transform: translate(-50%,-50%) rotate(24deg) scale(.08); } }
@keyframes eclipseUnveil { 0%,72% { opacity: 1; transform: translate(-50%,-50%) scale(1.15); } 100% { opacity: .03; transform: translate(-50%,-50%) scale(1.65); } }
@keyframes summonBloom { 0% { opacity: .6; transform: scale(.5); } 40% { opacity: .55; } 100% { opacity: .08; transform: scale(1.7); } }
@keyframes sealWave { 0% { opacity: .8; transform: scale(.3); } 100% { opacity: 0; transform: scale(2.5); border-width: 1px; } }
@keyframes paperScatter { from { opacity: .9; transform: translateY(0) rotate(0); } to { opacity: 0; transform: translateY(calc(-1 * var(--travel))) rotate(160deg); } }
@keyframes rayBloom { from { transform: scaleY(.15); } 35% { transform: scaleY(1); } to { opacity: 0; transform: scaleY(1.3); } }
@keyframes companionArrive { from { opacity: 0; transform: translateY(22px) scale(.85); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes eclipseOrbit { from { opacity: .8; width: 38%; height: 38%; } to { opacity: .22; width: 91%; height: 46%; } }
@keyframes petalOpen { from { opacity: .8; width: 34%; height: 34%; } to { opacity: .2; width: 78%; height: 78%; } }
@keyframes compassOpen { from { transform: rotate(-45deg) scale(.6); opacity: .8; } to { transform: rotate(45deg) scale(1); opacity: .3; } }
@media (max-height: 520px) { .summon-overlay { padding-top: 2px; padding-bottom: 7px; }.summon-header { flex-basis: 44px; height: 44px; }.summon-footer { flex-basis: 108px; }.summon-portrait { height: 39vh; margin-top: 3px; margin-bottom: 5px; }.summon-rank { height: 28px; font-size: 18px; }.summon-name { font-size: 23px; }.summon-meeting { margin-top: 3px; font-size: 12px; }.summon-anticipation { font-size: 16px; }.summon-anticipation text { margin-top: 5px; } }
@media (prefers-reduced-motion: reduce) { .summon-halo, .summon-wax, .summon-particle, .summon-ray, .summon-ring, .summon-letter, .summon-eclipse, .summon-shockwave, .summon-reveal, .summon-orbit, .summon-compass { animation: none !important; transition: none !important; }.phase-burst .summon-letter { opacity: 0; }.summon-particles, .summon-rays, .summon-shockwave { display: none; } }
